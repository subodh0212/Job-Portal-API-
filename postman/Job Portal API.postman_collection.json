    {
      "name": "{{baseUrl}}/api/auth/login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "\r",
              "const response = pm.response.json();\r",
              "\r",
              "if (pm.response.code === 200 && response.token) {\r",
              "    const role = response.data.role;\r",
              "\r",
              "    if (role === \"candidate\") {\r",
              "        pm.environment.set(\"candidateToken\", response.token);\r",
              "    } else if (role === \"employer\") {\r",
              "        pm.environment.set(\"employerToken\", response.token);\r",
              "    }\r",
              "\r",
              "    console.log(\"Login token saved for:\", role);\r",
              "}\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
