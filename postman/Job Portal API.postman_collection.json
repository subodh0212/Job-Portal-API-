          "name": "Apply for Job",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();\r",
                  "\r",
                  "if (pm.response.code === 201 && response.data?._id) {\r",
                  "    pm.environment.set(\"applicationId\", response.data._id);\r",
                  "    console.log(\"Application ID saved:\", response.data._id);\r",
                  "}"
